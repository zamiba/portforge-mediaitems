{
  "title": "Settings",
  "path": "install/shipofharkinian.json",
  "format": "json",
  "reference": {
    "file": "shipofharkinian.json.example"
  },
  "sections": [
    {
      "title": "Window",
      "help": "Written when the game quits. The size is remembered only from a windowed session.",
      "fields": [
        {
          "pointer": "Window.Width",
          "kind": "int",
          "widget": "number",
          "label": "Window width",
          "default": 640,
          "min": 320,
          "max": 7680,
          "step": 1,
          "unit": "px"
        },
        {
          "pointer": "Window.Height",
          "kind": "int",
          "widget": "number",
          "label": "Window height",
          "default": 480,
          "min": 240,
          "max": 4320,
          "step": 1,
          "unit": "px"
        },
        {
          "pointer": "Window.Fullscreen.Enabled",
          "kind": "bool",
          "widget": "toggle",
          "label": "Start fullscreen",
          "default": false
        },
        {
          "pointer": "Window.AudioBackend",
          "kind": "string",
          "widget": "select",
          "label": "Audio output",
          "help": "SDL works everywhere; WASAPI is Windows only and Core Audio is macOS only.",
          "options": [
            {
              "label": "SDL",
              "value": "sdl"
            },
            {
              "label": "WASAPI (Windows)",
              "value": "wasapi"
            },
            {
              "label": "Core Audio (macOS)",
              "value": "coreaudio"
            },
            {
              "label": "None",
              "value": "null"
            }
          ]
        }
      ]
    },
    {
      "title": "Graphics",
      "fields": [
        {
          "pointer": "CVars.gSettings.VsyncEnabled",
          "kind": "int",
          "widget": "toggle",
          "label": "V-sync",
          "help": "Removes tearing, but caps the frame rate at the display's refresh rate.",
          "on": 1,
          "off": 0,
          "default": 1
        },
        {
          "pointer": "CVars.gSettings.InternalResolution",
          "kind": "float",
          "widget": "slider",
          "label": "Internal resolution",
          "help": "Renders at a multiple of the output resolution as a form of anti-aliasing.",
          "default": 1.0,
          "min": 0.5,
          "max": 2.0,
          "step": 0.1,
          "unit": "×"
        },
        {
          "pointer": "CVars.gSettings.MSAAValue",
          "kind": "int",
          "widget": "slider",
          "label": "Anti-aliasing (MSAA)",
          "help": "Samples per pixel, from 1 (off) to 8.",
          "default": 1,
          "min": 1,
          "max": 8,
          "step": 1,
          "unit": "×"
        },
        {
          "pointer": "CVars.gSettings.TextureFilter",
          "kind": "int",
          "widget": "select",
          "label": "Texture filter",
          "help": "Takes effect the next time the game starts.",
          "options": [
            {
              "label": "Three-point",
              "value": 0
            },
            {
              "label": "Linear",
              "value": 1
            },
            {
              "label": "None",
              "value": 2
            }
          ],
          "default": 0
        },
        {
          "pointer": "CVars.gSettings.MatchRefreshRate",
          "kind": "int",
          "widget": "toggle",
          "label": "Match refresh rate",
          "help": "Follows the display's refresh rate instead of the frame rate below.",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gSettings.InterpolationFPS",
          "kind": "int",
          "widget": "number",
          "label": "Frame rate",
          "help": "Frames the game interpolates to. Ignored while Match refresh rate is on.",
          "default": 20,
          "min": 20,
          "max": 360,
          "step": 1,
          "unit": "fps"
        },
        {
          "pointer": "CVars.gSettings.LowResMode",
          "kind": "int",
          "widget": "toggle",
          "label": "N64 mode",
          "help": "Renders at the console's own resolution.",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gSettings.SdlWindowedFullscreen",
          "kind": "int",
          "widget": "toggle",
          "label": "Windowed fullscreen",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gSettings.EnableMultiViewports",
          "kind": "int",
          "widget": "toggle",
          "label": "Allow multiple windows",
          "help": "Takes effect the next time the game starts.",
          "on": 1,
          "off": 0,
          "default": 1
        }
      ]
    },
    {
      "title": "Audio",
      "fields": [
        {
          "pointer": "CVars.gSettings.Volume.Master",
          "kind": "int",
          "widget": "slider",
          "label": "Master volume",
          "default": 40,
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%"
        },
        {
          "pointer": "CVars.gSettings.Volume.MainMusic",
          "kind": "int",
          "widget": "slider",
          "label": "Main music volume",
          "default": 100,
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%"
        },
        {
          "pointer": "CVars.gSettings.Volume.SubMusic",
          "kind": "int",
          "widget": "slider",
          "label": "Sub music volume",
          "default": 100,
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%"
        },
        {
          "pointer": "CVars.gSettings.Volume.Fanfare",
          "kind": "int",
          "widget": "slider",
          "label": "Fanfare volume",
          "default": 100,
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%"
        },
        {
          "pointer": "CVars.gSettings.Volume.SFX",
          "kind": "int",
          "widget": "slider",
          "label": "Sound effects volume",
          "default": 100,
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%"
        }
      ]
    },
    {
      "title": "Language",
      "fields": [
        {
          "pointer": "CVars.gSettings.Languages",
          "kind": "int",
          "widget": "radio",
          "label": "Language",
          "options": [
            {
              "label": "English",
              "value": 0
            },
            {
              "label": "German",
              "value": 1
            },
            {
              "label": "French",
              "value": 2
            }
          ],
          "default": 0
        },
        {
          "pointer": "CVars.gSettings.TitleScreenTranslation",
          "kind": "int",
          "widget": "toggle",
          "label": "Translate the title screen",
          "on": 1,
          "off": 0,
          "default": 0
        }
      ]
    },
    {
      "title": "Accessibility",
      "fields": [
        {
          "pointer": "CVars.gSettings.A11yTTS",
          "kind": "int",
          "widget": "toggle",
          "label": "Text to speech",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gSettings.A11yNoJabuWobble",
          "kind": "int",
          "widget": "toggle",
          "label": "Disable Jabu wobble",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gSettings.A11yNoHeatHaze",
          "kind": "int",
          "widget": "toggle",
          "label": "Disable heat haze",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gSettings.DisableFirstPersonAutoCenterView",
          "kind": "int",
          "widget": "toggle",
          "label": "Disable idle camera re-centering",
          "on": 1,
          "off": 0,
          "default": 0
        }
      ]
    },
    {
      "title": "Controls",
      "fields": [
        {
          "pointer": "CVars.gSettings.Controls.InvertAimingXAxis",
          "kind": "int",
          "widget": "toggle",
          "label": "Invert aiming X axis",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gSettings.Controls.InvertAimingYAxis",
          "kind": "int",
          "widget": "toggle",
          "label": "Invert aiming Y axis",
          "on": 1,
          "off": 0,
          "default": 1
        },
        {
          "pointer": "CVars.gSettings.Controls.RightStickAim",
          "kind": "int",
          "widget": "toggle",
          "label": "Aim with the right stick",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gSettings.DpadInText",
          "kind": "int",
          "widget": "toggle",
          "label": "D-pad in text boxes",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gSettings.DPadOnPause",
          "kind": "int",
          "widget": "toggle",
          "label": "D-pad on the pause screen",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gSettings.EnableMouse",
          "kind": "int",
          "widget": "toggle",
          "label": "Enable mouse input",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gSettings.AutoCaptureMouse",
          "kind": "int",
          "widget": "toggle",
          "label": "Capture the mouse automatically",
          "on": 1,
          "off": 0,
          "default": 1
        }
      ]
    }
  ]
}
