{
  "userDataPaths": [
    { "locationType": "runDir", "path": "install/saves" },
    { "locationType": "runDir", "path": "install/snapsettings.json" },
    { "locationType": "runDir", "path": "install/snapsettings.json.bak" },
    { "locationType": "runDir", "path": "install/photos" },
    { "locationType": "runDir", "path": "install/stickers" }
  ],
  "dependencies": [],
  "uninstallSteps": [
    { "step": "deletePath", "path": "install" }
  ],
  "builds": [
    {
      "versions": ["1.0.2", "1.0.3", "1.0.4", "1.0.5", "1.0.6", "1.0.7", "1.0.8", "1.0.9"],
      "targetPlatforms": {
        "Windows": { "slug": "win64", "archiveExt": "zip", "executable": "Snap64Recomp.exe" },
        "Linux": { "slug": "linux-x86_64", "archiveExt": "tar.gz", "executable": "Snap64Recomp" }
      },
      "steps": [
        { "step": "createDir", "path": ".build" },
        {
          "step": "fetch",
          "url": "https://github.com/JackandBeans/Snap64Recomp/releases/download/v${version}/Snap64Recomp-${version}-${platform.slug}.${platform.archiveExt}",
          "dest": ".build/Snap64Recomp-${version}-${platform.slug}.${platform.archiveExt}"
        },
        {
          "step": "extract",
          "src": ".build/Snap64Recomp-${version}-${platform.slug}.${platform.archiveExt}",
          "dest": ".build"
        },
        { "step": "deletePath", "path": ".build/Snap64Recomp-${version}-${platform.slug}.${platform.archiveExt}" },
        { "step": "move", "src": ".build/Snap64Recomp-${version}-${platform.slug}", "dest": "install" },
        { "step": "deletePath", "path": ".build" },
        { "step": "copy", "from": "rom", "dest": "install/pokemonsnap.z64" },
        { "step": "defineExecutable", "executable": "install/${platform.executable}", "title": "Play" }
      ]
    }
  ]
}
