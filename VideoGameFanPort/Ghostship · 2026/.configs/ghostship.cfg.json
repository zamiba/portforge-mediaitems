{
  "title": "Settings",
  "path": "install/ghostship.cfg.json",
  "format": "json",
  "sections": [
    {
      "title": "Window",
      "help": "Written when the game quits. The size is remembered only from a windowed session.",
      "fields": [
        {
          "pointer": "Window.Width",
          "kind": "int",
          "widget": "number",
          "label": "Window width",
          "default": 640,
          "min": 320,
          "max": 7680,
          "step": 1,
          "unit": "px"
        },
        {
          "pointer": "Window.Height",
          "kind": "int",
          "widget": "number",
          "label": "Window height",
          "default": 480,
          "min": 240,
          "max": 4320,
          "step": 1,
          "unit": "px"
        },
        {
          "pointer": "Window.Fullscreen.Enabled",
          "kind": "bool",
          "widget": "toggle",
          "label": "Start fullscreen",
          "default": false
        },
        {
          "pointer": "Window.AudioBackend",
          "kind": "string",
          "widget": "select",
          "label": "Audio output",
          "help": "SDL works everywhere; WASAPI is Windows only and Core Audio is macOS only.",
          "options": [
            {
              "label": "SDL",
              "value": "sdl"
            },
            {
              "label": "WASAPI (Windows)",
              "value": "wasapi"
            },
            {
              "label": "Core Audio (macOS)",
              "value": "coreaudio"
            },
            {
              "label": "None",
              "value": "null"
            }
          ]
        }
      ]
    },
    {
      "title": "Graphics",
      "fields": [
        {
          "pointer": "CVars.gSettings.VsyncEnabled",
          "kind": "int",
          "widget": "toggle",
          "label": "V-sync",
          "help": "Removes tearing, but caps the frame rate at the display's refresh rate.",
          "on": 1,
          "off": 0,
          "default": 1
        },
        {
          "pointer": "CVars.gSettings.InternalResolution",
          "kind": "float",
          "widget": "slider",
          "label": "Internal resolution",
          "help": "Renders at a multiple of the output resolution as a form of anti-aliasing.",
          "default": 1.0,
          "min": 0.5,
          "max": 2.0,
          "step": 0.1,
          "unit": "×"
        },
        {
          "pointer": "CVars.gSettings.MSAAValue",
          "kind": "int",
          "widget": "slider",
          "label": "Anti-aliasing (MSAA)",
          "help": "Samples per pixel, from 1 (off) to 8.",
          "default": 1,
          "min": 1,
          "max": 8,
          "step": 1,
          "unit": "×"
        },
        {
          "pointer": "CVars.gSettings.TextureFilter",
          "kind": "int",
          "widget": "select",
          "label": "Texture filter",
          "help": "Takes effect the next time the game starts.",
          "options": [
            {
              "label": "Three-point",
              "value": 0
            },
            {
              "label": "Linear",
              "value": 1
            },
            {
              "label": "None",
              "value": 2
            }
          ],
          "default": 0
        },
        {
          "pointer": "CVars.gSettings.MatchRefreshRate",
          "kind": "int",
          "widget": "toggle",
          "label": "Match refresh rate",
          "help": "Follows the display's refresh rate instead of the frame rate below.",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gSettings.InterpolationFPS",
          "kind": "int",
          "widget": "number",
          "label": "Frame rate",
          "help": "Frames the game interpolates to. Ignored while Match refresh rate is on.",
          "default": 30,
          "min": 20,
          "max": 360,
          "step": 1,
          "unit": "fps"
        },
        {
          "pointer": "CVars.gSettings.LowResMode",
          "kind": "int",
          "widget": "toggle",
          "label": "N64 mode",
          "help": "Renders at the console's own resolution.",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gSettings.SdlWindowedFullscreen",
          "kind": "int",
          "widget": "toggle",
          "label": "Windowed fullscreen",
          "on": 1,
          "off": 0,
          "default": 0
        }
      ]
    },
    {
      "title": "Audio",
      "fields": [
        {
          "pointer": "CVars.gSettings.Volume.Master",
          "kind": "int",
          "widget": "slider",
          "label": "Master volume",
          "default": 100,
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%"
        },
        {
          "pointer": "CVars.gSettings.Volume.MainMusic",
          "kind": "int",
          "widget": "slider",
          "label": "Music volume",
          "default": 100,
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%"
        },
        {
          "pointer": "CVars.gSettings.Volume.SFX",
          "kind": "int",
          "widget": "slider",
          "label": "Sound effects volume",
          "default": 100,
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%"
        },
        {
          "pointer": "CVars.gSettings.Volume.Environment",
          "kind": "int",
          "widget": "slider",
          "label": "Environment volume",
          "default": 100,
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%"
        }
      ]
    },
    {
      "title": "Enhancements",
      "fields": [
        {
          "pointer": "CVars.gEnhancements.DisableLOD",
          "kind": "int",
          "widget": "toggle",
          "label": "Disable level of detail",
          "help": "Always draws models at their highest detail.",
          "on": 1,
          "off": 0,
          "default": 1
        },
        {
          "pointer": "CVars.gEnhancements.DisableDrawDistance",
          "kind": "int",
          "widget": "toggle",
          "label": "Disable draw distance",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gEnhancements.Mods.AlternateAssets",
          "kind": "int",
          "widget": "toggle",
          "label": "Use alternate assets",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gEnhancements.DisableLakituCutscene",
          "kind": "int",
          "widget": "toggle",
          "label": "Skip the Lakitu intro",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gEnhancements.DisablePeachCutscene",
          "kind": "int",
          "widget": "toggle",
          "label": "Skip the Peach letter",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gEnhancements.StarNoExit",
          "kind": "int",
          "widget": "toggle",
          "label": "Stay in the level after a star",
          "on": 1,
          "off": 0,
          "default": 0
        }
      ]
    },
    {
      "title": "Camera",
      "fields": [
        {
          "pointer": "CVars.gEnhancements.Camera.InvertedVerticalCamera",
          "kind": "int",
          "widget": "toggle",
          "label": "Invert vertical camera",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gEnhancements.Camera.InvertedHorizontalCamera",
          "kind": "int",
          "widget": "toggle",
          "label": "Invert horizontal camera",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gEnhancements.Camera.ImprovedCButtonCamera",
          "kind": "int",
          "widget": "toggle",
          "label": "Improved C-button camera",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gEnhancements.Camera.CameraSpeed",
          "kind": "float",
          "widget": "slider",
          "label": "Camera speed",
          "default": 32.0,
          "min": 1.0,
          "max": 100.0,
          "step": 1.0
        }
      ]
    }
  ]
}
