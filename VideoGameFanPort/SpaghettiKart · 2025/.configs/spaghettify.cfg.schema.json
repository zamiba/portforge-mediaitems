{
  "title": "Settings",
  "path": "install/spaghettify.cfg.json",
  "format": "json",
  "reference": {
    "file": "spaghettify.cfg.json.example"
  },
  "sections": [
    {
      "title": "Window",
      "help": "Written when the game quits. The size is remembered only from a windowed session.",
      "fields": [
        {
          "pointer": "Window.Width",
          "kind": "int",
          "widget": "number",
          "label": "Window width",
          "default": 640,
          "min": 320,
          "max": 7680,
          "step": 1,
          "unit": "px"
        },
        {
          "pointer": "Window.Height",
          "kind": "int",
          "widget": "number",
          "label": "Window height",
          "default": 480,
          "min": 240,
          "max": 4320,
          "step": 1,
          "unit": "px"
        },
        {
          "pointer": "Window.Fullscreen.Enabled",
          "kind": "bool",
          "widget": "toggle",
          "label": "Start fullscreen",
          "default": false
        },
        {
          "pointer": "Window.AudioBackend",
          "kind": "string",
          "widget": "select",
          "label": "Audio output",
          "help": "SDL works everywhere; WASAPI is Windows only and Core Audio is macOS only.",
          "options": [
            {
              "label": "SDL",
              "value": "sdl"
            },
            {
              "label": "WASAPI (Windows)",
              "value": "wasapi"
            },
            {
              "label": "Core Audio (macOS)",
              "value": "coreaudio"
            },
            {
              "label": "None",
              "value": "null"
            }
          ]
        }
      ]
    },
    {
      "title": "Graphics",
      "fields": [
        {
          "pointer": "CVars.gVsyncEnabled",
          "kind": "int",
          "widget": "toggle",
          "label": "V-sync",
          "help": "Removes tearing, but caps the frame rate at the display's refresh rate.",
          "on": 1,
          "off": 0,
          "default": 1
        },
        {
          "pointer": "CVars.gInternalResolution",
          "kind": "float",
          "widget": "slider",
          "label": "Internal resolution",
          "help": "Renders at a multiple of the output resolution as a form of anti-aliasing.",
          "default": 1.0,
          "min": 0.5,
          "max": 2.0,
          "step": 0.1,
          "unit": "×"
        },
        {
          "pointer": "CVars.gMSAAValue",
          "kind": "int",
          "widget": "slider",
          "label": "Anti-aliasing (MSAA)",
          "help": "Samples per pixel, from 1 (off) to 8.",
          "default": 1,
          "min": 1,
          "max": 8,
          "step": 1,
          "unit": "×"
        },
        {
          "pointer": "CVars.gTextureFilter",
          "kind": "int",
          "widget": "select",
          "label": "Texture filter",
          "help": "Takes effect the next time the game starts.",
          "options": [
            {
              "label": "Three-point",
              "value": 0
            },
            {
              "label": "Linear",
              "value": 1
            },
            {
              "label": "None",
              "value": 2
            }
          ],
          "default": 0
        },
        {
          "pointer": "CVars.gMatchRefreshRate",
          "kind": "int",
          "widget": "toggle",
          "label": "Match refresh rate",
          "help": "Follows the display's refresh rate instead of the frame rate below.",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gInterpolationFPS",
          "kind": "int",
          "widget": "number",
          "label": "Frame rate",
          "help": "Frames the game interpolates to. Ignored while Match refresh rate is on.",
          "default": 30,
          "min": 20,
          "max": 360,
          "step": 1,
          "unit": "fps"
        },
        {
          "pointer": "CVars.gLowResMode",
          "kind": "int",
          "widget": "toggle",
          "label": "N64 mode",
          "help": "Renders at the console's own resolution.",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gDisableLod",
          "kind": "int",
          "widget": "toggle",
          "label": "No level of detail",
          "help": "Always draws models at their highest detail.",
          "on": 1,
          "off": 0,
          "default": 1
        },
        {
          "pointer": "CVars.gFixVisuals",
          "kind": "int",
          "widget": "toggle",
          "label": "Fix visual glitches",
          "on": 1,
          "off": 0,
          "default": 0
        }
      ]
    },
    {
      "title": "Audio",
      "fields": [
        {
          "pointer": "CVars.gGameMasterVolume",
          "kind": "float",
          "widget": "slider",
          "label": "Master volume",
          "default": 1.0,
          "min": 0.0,
          "max": 1.0,
          "step": 0.05
        },
        {
          "pointer": "CVars.gMainMusicVolume",
          "kind": "float",
          "widget": "slider",
          "label": "Music volume",
          "default": 1.0,
          "min": 0.0,
          "max": 1.0,
          "step": 0.05
        },
        {
          "pointer": "CVars.gSFXMusicVolume",
          "kind": "float",
          "widget": "slider",
          "label": "Sound effects volume",
          "default": 1.0,
          "min": 0.0,
          "max": 1.0,
          "step": 0.05
        },
        {
          "pointer": "CVars.gEnvironmentVolume",
          "kind": "float",
          "widget": "slider",
          "label": "Environment volume",
          "default": 1.0,
          "min": 0.0,
          "max": 1.0,
          "step": 0.05
        }
      ]
    },
    {
      "title": "Gameplay",
      "fields": [
        {
          "pointer": "CVars.gSkipIntro",
          "kind": "int",
          "widget": "toggle",
          "label": "Skip the intro",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gEnableDigitalSpeedometer",
          "kind": "int",
          "widget": "toggle",
          "label": "Digital speedometer",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gBetterResultPortraits",
          "kind": "int",
          "widget": "toggle",
          "label": "Better result portraits",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gUniqueCharacterSelections",
          "kind": "int",
          "widget": "toggle",
          "label": "One character per player",
          "on": 1,
          "off": 0,
          "default": 1
        },
        {
          "pointer": "CVars.gDisableRubberbanding",
          "kind": "int",
          "widget": "toggle",
          "label": "Disable rubber-banding",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gHarderCPU",
          "kind": "int",
          "widget": "toggle",
          "label": "Harder CPU drivers",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gShellsShootStraight",
          "kind": "int",
          "widget": "toggle",
          "label": "Shells travel straight",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gEnableCustomCC",
          "kind": "int",
          "widget": "toggle",
          "label": "Custom engine class",
          "on": 1,
          "off": 0,
          "default": 0
        },
        {
          "pointer": "CVars.gCustomCC",
          "kind": "float",
          "widget": "number",
          "label": "Custom engine class speed",
          "help": "Only used while Custom engine class is on. 150 matches 150cc.",
          "default": 150.0,
          "min": 50.0,
          "max": 500.0,
          "step": 10.0
        }
      ]
    }
  ]
}
